# ──────────────────────────────────────────────
# Site URL
# ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://r6hub.yourdomain.com

# ──────────────────────────────────────────────
# Supabase
# ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_REALTIME_URL=ws://your-vps-ip:4000
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ──────────────────────────────────────────────
# VPS / Docker
# ──────────────────────────────────────────────
DOMAIN=r6hub.yourdomain.com

# ──────────────────────────────────────────────
# Sentry
# ──────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
SENTRY_AUTH_TOKEN=your-auth-token

# ──────────────────────────────────────────────
# PostHog Analytics
# ──────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ──────────────────────────────────────────────
# Lemon Squeezy (Pro subscriptions)
# https://app.lemonsqueezy.com/settings/api
# ──────────────────────────────────────────────
# API key per verificare licenze (read-only ok)
LEMON_SQUEEZY_API_KEY=your-lemon-squeezy-api-key
# Secret per verificare la firma HMAC dei webhook
LEMON_SQUEEZY_WEBHOOK_SECRET=your-webhook-signing-secret
# URL checkout del prodotto r6hub Pro (€3.99/mese)
# NEXT_PUBLIC_* per accesso client-side (pagina /upgrade)
LEMON_SQUEEZY_CHECKOUT_URL=https://your-store.lemonsqueezy.com/checkout/buy/your-product
NEXT_PUBLIC_LEMON_SQUEEZY_CHECKOUT_URL=https://your-store.lemonsqueezy.com/checkout/buy/your-product
